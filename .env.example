# SparkSage configuration template.
#
# Copy to `.env` and fill in your values:   cp .env.example .env
# `.env` is git-ignored -- never commit real secrets.
#
# Priority (highest first), per the 12-factor convention:
#   1. Real environment variables (container / CI / shell `export`)
#   2. Values in this `.env` file
# So anything already set in the environment wins over this file.
#
# This file uses the subset of .env syntax SparkSage supports:
#   KEY=VALUE | KEY="quoted" | KEY='quoted' | export KEY=VALUE | # comments
# Shell expansion ($VAR, $(...), backticks) is NOT interpreted.

# --- LLM / generation --------------------------------------------------------
# API key. SPARKSAGE_* takes priority over the OPENAI_* fallbacks below.
SPARKSAGE_API_KEY=
# OpenAI-compatible base URL. Omit for the public OpenAI endpoint; set for
# Azure / vLLM / Ollama / GLM / self-hosted / any custom endpoint.
# SPARKSAGE_BASE_URL=https://api.openai.com/v1
# Model id. Defaults to gpt-4o-mini when unset.
SPARKSAGE_MODEL=gpt-4o-mini
# Stream the LLM response (accumulate streamed deltas). On by default.
# Set to false/0/no/off to disable. 1/true/yes/on to enable.
SPARKSAGE_STREAM=true
# BCP-47 language code written into every generated IdeaBlock (e.g. en, zh).
SPARKSAGE_LANGUAGE=en

# --- Logging -----------------------------------------------------------------
# Verbosity of the `sparksage` logger. One of:
#   CRITICAL / ERROR / WARNING / INFO / DEBUG  (case-insensitive), or an int.
# Defaults to WARNING (quiet). Bump to INFO / DEBUG when diagnosing conversion,
# cleaning or generation. Real env vars win over this file.
SPARKSAGE_LOG_LEVEL=WARNING

# --- Document management -----------------------------------------------------
# Durable storage for the /api/v1/documents routes.
# Empty/unset -> in-memory store (works out of the box, lost on restart).
# Set to a file path to persist documents + tags across restarts via SQLite.
# SPARKSAGE_DOC_STORE=./sparksage.docs.db
# SQLite table name (default: documents). Must match ^[A-Za-z_][A-Za-z0-9_]*$.
# SPARKSAGE_DOC_STORE_TABLE=documents
# Keyword-extraction algorithm used to auto-tag documents without tags.
# One of: rake | tfidf | textrank   (default: rake).
# SPARKSAGE_AUTO_TAG_EXTRACTOR=rake
# Use jieba for CJK word segmentation when auto-tagging Chinese/Japanese/Korean
# text (requires: pip install 'sparksage[tags-zh]'). Default false -- the
# dependency-free character-bigram tokenizer is used otherwise.
# SPARKSAGE_TAGS_ZH=false

# --- End-to-end QA -----------------------------------------------------------
# Embedding model for the knowledge base (ingest + retrieval share one model).
# Default: text-embedding-3-small.
# SPARKSAGE_EMBEDDING_MODEL=text-embedding-3-small
# Embedding API key. Falls back to SPARKSAGE_API_KEY / OPENAI_API_KEY when unset.
# SPARKSAGE_EMBEDDING_API_KEY=
# Embedding base URL. Falls back to SPARKSAGE_BASE_URL / OPENAI_BASE_URL.
# SPARKSAGE_EMBEDDING_BASE_URL=

# --- Fallbacks (only used if the SPARKSAGE_* var above is unset) -------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
