# SparkSage configuration template.
#
# Copy to `.env` and fill in your values:   cp .env.example .env
# `.env` is git-ignored -- never commit real secrets.
#
# Priority (highest first), per the 12-factor convention:
#   1. Real environment variables (container / CI / shell `export`)
#   2. Values in this `.env` file
# So anything already set in the environment wins over this file.
#
# This file uses the subset of .env syntax SparkSage supports:
#   KEY=VALUE | KEY="quoted" | KEY='quoted' | export KEY=VALUE | # comments
# Shell expansion ($VAR, $(...), backticks) is NOT interpreted.

# --- LLM / generation --------------------------------------------------------
# API key. SPARKSAGE_* takes priority over the OPENAI_* fallbacks below.
SPARKSAGE_API_KEY=
# OpenAI-compatible base URL. Omit for the public OpenAI endpoint; set for
# Azure / vLLM / Ollama / GLM / self-hosted / any custom endpoint.
# SPARKSAGE_BASE_URL=https://api.openai.com/v1
# Model id. Defaults to gpt-4o-mini when unset.
SPARKSAGE_MODEL=gpt-4o-mini
# Stream the LLM response (accumulate streamed deltas). On by default.
# Set to false/0/no/off to disable. 1/true/yes/on to enable.
SPARKSAGE_STREAM=true
# BCP-47 language code written into every generated IdeaBlock (e.g. en, zh).
SPARKSAGE_LANGUAGE=en
# Output-token cap forwarded to the provider. Some OpenAI-compatible endpoints
# (BigModel/GLM, vLLM, Ollama) default to a low max_output_tokens that truncates
# long JSON mid-key -> unparseable responses / skipped segments. Set to a value
# that fits your model's context (e.g. 4096); "off" leaves it to the provider.
# SPARKSAGE_MAX_TOKENS=4096
# Per-request LLM timeout in seconds. A finite default (120) bounds a stuck
# connection so ingest fails fast instead of hanging. "off" disables the cap.
# SPARKSAGE_LLM_TIMEOUT=120
# Per-segment character budget for large inputs. Source text longer than this is
# split into segments, each its own LLM call. Larger -> fewer requests (default
# 12000 fits modern 128k-context models comfortably).
# SPARKSAGE_MAX_INPUT_CHARS=12000
# Segments generated concurrently. The biggest latency win on large uploads: a
# multi-segment document fans out into parallel LLM calls instead of a serial
# queue (4 segments @ ~60s -> ~1 round instead of ~4 min). Default: 4.
# SPARKSAGE_GENERATE_MAX_WORKERS=4

# --- Logging -----------------------------------------------------------------
# Verbosity of the `sparksage` logger. One of:
#   CRITICAL / ERROR / WARNING / INFO / DEBUG  (case-insensitive), or an int.
# Defaults to WARNING (quiet). Bump to INFO / DEBUG when diagnosing conversion,
# cleaning or generation. Real env vars win over this file.
SPARKSAGE_LOG_LEVEL=WARNING

# --- Conversion --------------------------------------------------------------
# Format-conversion engine. One of:
#   markitdown | anydoc   (default: markitdown)
# markitdown (Microsoft) covers the broadest format matrix. anydoc (Firecrawl)
# is a fast local Rust converter for office docs + PDF, with no ML models / no
# cloud calls -- a good default when the corpus is mostly Word/Excel/PPT/PDF.
# anydoc requires: pip install 'sparksage[convert-anydoc]'.
# SPARKSAGE_CONVERTER=markitdown

# --- Document management -----------------------------------------------------
# Durable storage for the /api/v1/documents routes.
# The simplest knob is SPARKSAGE_DATA_DIR (one directory holds every SQLite
# file: documents, KB metadata, KB state, feedback). Set it once and a Docker
# restart loses nothing. Empty/unset -> everything in-memory (lost on restart).
#   docker run -v "$PWD/data:/app/data" -e SPARKSAGE_DATA_DIR=/app/data ...
# SPARKSAGE_DOC_STORE overrides just the document-store file path. Set to a
# file path for durable SQLite storage; ":memory:" for an explicit in-memory
# store. When unset, falls back to {SPARKSAGE_DATA_DIR}/sparksage.docs.db.
# SPARKSAGE_DOC_STORE=./sparksage.docs.db
# SQLite table name (default: documents). Must match ^[A-Za-z_][A-Za-z0-9_]*$.
# SPARKSAGE_DOC_STORE_TABLE=documents
# Keyword-extraction algorithm used to auto-tag documents without tags.
# One of: rake | tfidf | textrank   (default: rake).
# SPARKSAGE_AUTO_TAG_EXTRACTOR=rake
# Use jieba for CJK word segmentation when auto-tagging Chinese/Japanese/Korean
# text (requires: pip install 'sparksage[tags-zh]'). Default false -- the
# dependency-free character-bigram tokenizer is used otherwise.
# SPARKSAGE_TAGS_ZH=false

# --- End-to-end QA -----------------------------------------------------------
# Embedding model for the knowledge base (ingest + retrieval share one model).
# Default: text-embedding-3-small.
# SPARKSAGE_EMBEDDING_MODEL=text-embedding-3-small
# Embedding API key. Falls back to SPARKSAGE_API_KEY / OPENAI_API_KEY when unset.
# SPARKSAGE_EMBEDDING_API_KEY=
# Embedding base URL. Falls back to SPARKSAGE_BASE_URL / OPENAI_BASE_URL.
# SPARKSAGE_EMBEDDING_BASE_URL=
# Agentic QA cap: max extra retrievals for POST /api/v1/query {mode:"agent"}.
# The agent controller (ReAct plan-act-observe-synthesize loop) is auto-wired
# whenever an LLM key is set; this bounds its latency. Default: 4.
# SPARKSAGE_AGENT_MAX_ITERATIONS=4
# Auto-wire the agent's per-step reflection components (retrieval grader +
# query refiner for the CRAG / Self-RAG ISREL gate). Default: on. Set to off
# for a pure ReAct loop (faster, but no per-step quality gate).
# SPARKSAGE_AGENT_REFLECTION=on
# Auto-wire the HyDE query expander (drafts a hypothetical answer per step and
# RRF-fuses it with the query). Each per-step expansion is an extra LLM call
# (~10-15s). Default: on. Set to off for the biggest single-call latency win
# -- ideal when the corpus already covers the query vocabulary.
# SPARKSAGE_AGENT_EXPANDER=on
# Per-step relevance floor below which the agent refines + re-retrieves.
# SPARKSAGE_AGENT_STEP_MIN_RELEVANCE=0.5
# Cap on per-step refine + re-retrieve rounds. Default: 1.
# SPARKSAGE_AGENT_STEP_MAX_REFINE=1
# Stall detector: after this many consecutive steps add ZERO new evidence the
# loop terminates early (synthesizes best-effort) instead of thrashing a barren
# corpus. Default: 2. Set to 0 to disable.
# SPARKSAGE_AGENT_MAX_STALE_STEPS=2

# --- Re-ranking --------------------------------------------------------------
# Cross-encoder re-ranking: set SPARKSAGE_RERANKER=on to wire a
# CrossEncoderReranker into every knowledge base, so `use_rerank=true` on
# POST /api/v1/query (dense / agent mode) actually re-orders the candidate pool
# instead of being silently skipped. Requires the `[rerank]` extra
# (sentence-transformers) -- included in the default Docker image.
# Default: off (no extra model is downloaded at startup).
# SPARKSAGE_RERANKER=off
# Hugging Face checkpoint. Default cross-encoder/ms-marco-MiniLM-L-6-v2 is small
# and English-trained; use BAAI/bge-reranker-v2-m3 for CJK / multilingual corpora
# (pairs well with SparkSage's dictionary-free CJK tokenizers).
# SPARKSAGE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Torch device (cpu / cuda / mps / ...). Auto-detected when unset.
# SPARKSAGE_RERANKER_DEVICE=cpu
# Per-pair max token length forwarded to the CrossEncoder. "off" leaves the
# provider default.
# SPARKSAGE_RERANKER_MAX_LENGTH=512
# Durable persistence for the QA knowledge base. SPARKSAGE_DATA_DIR covers all
# three; these override individual file paths when you want them split:
#   SPARKSAGE_KB_STORE        -- KB metadata (id / name / language / ACL / ...)
#   SPARKSAGE_KB_STATE_STORE  -- live block registry + vectors + doc-links
#                                (the indexed knowledge; reloaded on startup,
#                                no re-embedding on restart)
#   SPARKSAGE_FEEDBACK_STORE  -- user feedback (approval-ratio flywheel)
# SPARKSAGE_DATA_DIR=
# SPARKSAGE_KB_STORE=./sparksage.kb.db
# SPARKSAGE_KB_STATE_STORE=./sparksage.kb_state.db
# SPARKSAGE_FEEDBACK_STORE=./sparksage.feedback.db

# --- Fallbacks (only used if the SPARKSAGE_* var above is unset) -------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
